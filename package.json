{
  "name": "class-materials-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:companion": "tsx scripts/dev.ts",
    "slides": "slidev slides/slides.md",
    "glossary": "tsx scripts/class.ts generate",
    "preview": "tsx scripts/class.ts preview",
    "deploy": "tsx scripts/deploy.ts",
    "generate": "tsx scripts/generate.ts",
    "build": "pnpm typecheck && tsx scripts/class.ts build",
    "build:workshop": "tsx scripts/build-workshop.ts",
    "chat-key": "tsx scripts/chat-key.ts",
    "chat:setup": "tsx scripts/setup-chat.ts",
    "estimate-chat": "tsx scripts/estimate-chat.ts",
    "create-companion": "bash scripts/create-companion.sh",
    "typecheck": "astro check && tsc --noEmit --pretty false",
    "test": "tsx --test scripts/*.test.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "astro": "^7.3.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@slidev/cli": "^53.0.0",
    "@slidev/parser": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "wrangler": "^4.33.2"
  }
}
