{
  "name": "beyond-done",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:companion": "tsx scripts/dev.ts",
    "slides": "pnpm slides:qr && slidev slides/slides.md",
    "slides:qr": "tsx scripts/slides-qr.ts",
    "slides:check": "tsx scripts/check-deck.ts",
    "glossary": "tsx scripts/class.ts generate",
    "preview": "pnpm build && astro preview",
    "deploy:talks": "tsx scripts/deploy-talks.ts",
    "deploy:talks:dry-run": "tsx scripts/deploy-talks.ts --dry-run",
    "generate": "tsx scripts/generate.ts",
    "build": "pnpm typecheck && tsx scripts/class.ts build",
    "build:workshop": "tsx scripts/build-workshop.ts",
    "chat-key": "tsx scripts/chat-key.ts",
    "chat:setup": "tsx scripts/setup-chat.ts",
    "estimate-chat": "tsx scripts/estimate-chat.ts",
    "create-companion": "bash scripts/create-companion.sh",
    "typecheck": "astro check && tsc --noEmit --pretty false",
    "test": "tsx --test scripts/*.test.ts",
    "lab:doctor": "tsx lab/cli.ts doctor",
    "lab:replay": "tsx lab/cli.ts replay",
    "lab:app": "tsx lab/cli.ts app",
    "lab:check": "tsx lab/cli.ts check",
    "lab:loop": "tsx lab/cli.ts loop",
    "lab:eval": "tsx lab/cli.ts eval",
    "lab:exercise": "tsx lab/test-exercise.ts",
    "lab:test": "tsx --test lab/*.test.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "astro": "^7.3.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@playwright/test": "^1.64.0",
    "@slidev/cli": "^53.0.0",
    "@slidev/parser": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@types/node": "^24.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@workos/alto": "0.14.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "wrangler": "^4.33.2"
  }
}
