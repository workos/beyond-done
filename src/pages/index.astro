---
import { getCollection } from "astro:content";
import ClassLayout from "../layouts/ClassLayout.astro";
import { classConfig as config, withBase } from "../class-config";
const lessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
// Durations are free text. Only add them up when every lesson states one in minutes or hours.
const minutes = lessons.filter((lesson) => !lesson.data.prework).map((lesson) => {
  const match = /(\d+)\s*(min|minute|minutes|h|hr|hrs|hour|hours)\b/i.exec(lesson.data.duration ?? "");
  return match ? Number(match[1]) * (/^h/i.test(match[2]) ? 60 : 1) : NaN;
});
const total = minutes.length && minutes.every(Number.isFinite) ? minutes.reduce((sum, value) => sum + value, 0) : 0;
const totalTime = total >= 60 ? `${Math.floor(total / 60)} h${total % 60 ? ` ${total % 60} min` : ""}` : total ? `${total} min` : "";
---
<ClassLayout>
  <main id="content">
    <header class="hero">
      <div class="measure">
        <div class="topline"><span>{config.event || "Class materials"}</span></div>
        <h1>{config.title}</h1>
        <p class="subtitle">{config.description}</p>
        {config.audience && <p class="class-audience"><strong>Who it's for:</strong> {config.audience}</p>}
        <dl class="class-meta">
          {config.credit && <div><dt>Taught by</dt><dd>{config.credit}</dd></div>}
          <div><dt>Lessons</dt><dd>{lessons.length}</dd></div>
          {totalTime && <div><dt>Time</dt><dd>{totalTime}</dd></div>}
        </dl>
      </div>
    </header>
    <section class="measure main" aria-labelledby="lessons-heading">
      <div class="section-kicker">Work through these in order</div>
      <h2 id="lessons-heading">Lessons</h2>
      <ol class="lesson-list">
        {lessons.map((lesson, index) => <li>
          <a href={withBase(`/lessons/${lesson.id}/`)}>
            <span class="lesson-number">{String(index + 1).padStart(2, "0")}</span>
            <div><h3>{lesson.data.title}</h3><p>{lesson.data.description}</p>{lesson.data.duration && <small>{lesson.data.duration}</small>}</div>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>)}
      </ol>
      <aside class="class-reference"><strong>Need a definition?</strong><p>The glossary is a reference, not homework. Look things up as you go.</p><a href={withBase("/glossary/")}>Open the glossary →</a></aside>
    </section>
  </main>
</ClassLayout>
