{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workshop-companion",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
